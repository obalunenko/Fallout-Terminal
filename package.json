{
  "name": "fallout-terminal",
  "version": "1.0.0",
  "description": "Fallout-style terminal broadcaster for tabletop RPG sessions",
  "main": "main.js",
  "author": "Vault-Tec R&D",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "build:portable": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.vaulttec.fallout-terminal",
    "productName": "Fallout Terminal",
    "asar": false,
    "files": [
      "main.js",
      "server/**/*",
      "master/**/*",
      "client/**/*",
      "sessions/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true
    }
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
